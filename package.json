{
  "name": "openrecall",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "tsc -p tsconfig.tools.json && pnpm -r check",
    "package:windows": "node scripts/package-windows.mjs --version 1.0.0",
    "release:licenses": "node scripts/check-dependency-licenses.mjs",
    "smoke:package:windows": "node scripts/smoke-windows-package.mjs",
    "test": "vitest run",
    "test:package": "vitest run tests/ci/windows-package.test.ts",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm release:licenses && pnpm test && pnpm build",
    "verify:full": "pnpm verify && node scripts/smoke-production.mjs --skip-build && pnpm test:e2e",
    "dev": "pnpm --parallel --filter @openrecall/server --filter @openrecall/web dev",
    "start": "pnpm --filter @openrecall/server start"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "fast-check": "4.9.0",
    "sharp": "0.35.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
