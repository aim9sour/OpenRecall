{
  "name": "openrecall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "tsc -p tsconfig.tools.json && pnpm -r check",
    "release:licenses": "node scripts/check-dependency-licenses.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "pnpm --parallel --filter @openrecall/server --filter @openrecall/web dev",
    "start": "pnpm --filter @openrecall/server start"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "fast-check": "4.9.0",
    "sharp": "0.35.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
